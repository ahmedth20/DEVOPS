pipeline {
    agent any

    environment {
        DB_NAME = 'kaddemdb'
        DB_USER = 'root'
        DB_PASS = ''  
        DB_PORT = '3306'
        MYSQL_CONTAINER = 'mysql-test'
        NEXUS_URL = 'http://localhost:8081/repository/maven-releases/'
        MAVEN_SETTINGS = '/usr/share/maven/conf/settings.xml' // Assurez-vous que ce chemin est correct
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    git branch: 'Contrat', url: 'https://github.com/ahmedth20/DEVOPS.git'
                }
            }
        }

        stage('Test Docker') {
            steps {
                script {
                    sh '''
                    set -e
                    echo "Vérification de Docker..."
                    whoami
                    docker version
                    docker ps
                    '''
                }
            }
        }

        stage('Start MySQL') {
            steps {
                script {
                    sh '''
                    set -e
                    echo "Démarrage de MySQL..."
                    
                    # Vérifier si le conteneur existe déjà et est en cours d'exécution
                    if docker ps --format '{{.Names}}' | grep -q "^$MYSQL_CONTAINER$"; then
                        echo "Le conteneur MySQL est déjà en cours d'exécution."
                    elif docker ps -a --format '{{.Names}}' | grep -q "^$MYSQL_CONTAINER$"; then
                        echo "Le conteneur MySQL existe mais est arrêté. Redémarrage..."
                        docker start $MYSQL_CONTAINER
                    else
                        echo "Démarrage d'un nouveau conteneur MySQL..."
                        docker run --name $MYSQL_CONTAINER \
                            -e MYSQL_DATABASE=$DB_NAME \
                            -e MYSQL_ROOT_PASSWORD=$DB_PASS \
                            -p $DB_PORT:3306 \
                            -d mysql:8
                    fi

                    # Attente que MySQL soit prêt
                    echo "Attente de MySQL pour être prêt..."
                    for i in {1..30}; do
                        if docker exec $MYSQL_CONTAINER mysqladmin --user=root --password=$DB_PASS ping --silent; then
                            echo "MySQL est prêt."
                            break
                        fi
                        echo "Attente de MySQL (2 sec)..."
                        sleep 2
                    done

                    # Si MySQL n'est pas prêt après 60 secondes, échouer le pipeline
                    if ! docker exec $MYSQL_CONTAINER mysqladmin --user=root --password=$DB_PASS ping --silent; then
                        echo "MySQL n'a pas démarré correctement après 30 secondes." 
                        exit 1
                    fi
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    sh 'mvn clean compile'
                }
            }
        }

        // Déplacer le test avant SonarQube Analysis
        stage('Test') {
            steps {
                script {
                    sh 'mvn test'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh 'mvn sonar:sonar'
                }
            }
        }

        // Nouvelle étape de déploiement
        stage('Deploy to Nexus') {
            steps {
                script {
                    // Déploiement sur Nexus en utilisant mvn deploy
                    sh '''
                    echo "Déploiement vers Nexus..."
                    mvn deploy -DaltDeploymentRepository=deploymentRepo::default::http://localhost:8081/repository/maven-releases/ -s $MAVEN_SETTINGS
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                echo "Pipeline terminé."
            }
        }
        failure {
            script {
                echo "Une erreur est survenue."
            }
        }
    }
}
