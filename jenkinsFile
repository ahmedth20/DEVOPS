pipeline {
    agent any

    environment {
        DB_NAME = 'kaddemdb'
        DB_USER = 'root'
        DB_PASS = 'toor'  
        DB_PORT = '3306'
        MYSQL_CONTAINER = 'mysql-test'
        NEXUS_URL = 'http://localhost:8081/repository/maven-releases/'
        MAVEN_SETTINGS = '/usr/share/maven/conf/settings.xml'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'Contrat', url: 'https://github.com/ahmedth20/4TWIN5_G1_Kaddem.git'
            }
        }

        stage('Test Docker') {
            steps {
                sh '''
                    echo "🔍 Vérification Docker..."
                    whoami
                    docker version
                    docker ps
                '''
            }
        }

        stage('Start MySQL') {
            steps {
                script {
                    sh '''
                        echo "🧹 Nettoyage de l'ancien conteneur MySQL..."
                        if docker ps -a --format '{{.Names}}' | grep -q "^$MYSQL_CONTAINER$"; then
                          docker rm -f $MYSQL_CONTAINER
                        fi

                        echo "🚀 Lancement d’un nouveau conteneur MySQL..."
                        docker run -d --name $MYSQL_CONTAINER \
                          -e MYSQL_ROOT_PASSWORD=$DB_PASS \
                          -e MYSQL_DATABASE=$DB_NAME \
                          -p $DB_PORT:3306 \
                          mysql:5.7

                        echo "⏳ Pause initiale..."
                        sleep 5

                        echo "⌛ Attente de la disponibilité de MySQL..."
                        for i in {1..15}; do
                          if docker exec $MYSQL_CONTAINER mysqladmin ping -h "127.0.0.1" --user=root --password=$DB_PASS --silent; then
                            echo "✅ MySQL est prêt !"
                            exit 0
                          fi
                          echo "⏳ Tentative $i : MySQL non prêt encore..."
                          sleep 2
                        done

                        echo "❌ MySQL n’est pas prêt après 30 secondes. Échec."
                        exit 1
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo "🔍 Analyse SonarQube désactivée pour le moment."
                /*
                withSonarQubeEnv('SonarQube') {
                    sh 'mvn sonar:sonar'
                }
                */
            }
        }

        stage('Deploy') {
            steps {
                sh 'mvn deploy'
            }
        }

        stage('Docker Compose Up') {
            steps {
                sh 'docker compose up -d'
            }
        }
    }

    post {
        always {
            echo "✅ Pipeline terminé."
        }
        failure {
            echo "❌ Une erreur est survenue pendant l'exécution du pipeline."
        }
    }
}
