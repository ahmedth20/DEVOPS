pipeline {
    agent any

    environment {
        DB_NAME = 'kaddemdb'
        DB_USER = 'root'
        DB_PASS = ''
        DB_PORT = '3306'
        MYSQL_CONTAINER = 'mysql-test'
        NEXUS_URL = 'http://localhost:8081/repository/maven-releases/'
        MAVEN_SETTINGS = '/usr/share/maven/conf/settings.xml' // Vérifiez ce chemin
    }

    options {
        timestamps() // Active les timestamps dans les logs
        timeout(time: 30, unit: 'MINUTES') // Timeout global du pipeline
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    git branch: 'Contrat', url: 'https://github.com/ahmedth20/DEVOPS.git'
                }
            }
        }

        stage('Test Docker') {
            steps {
                script {
                    sh '''
                    #!/bin/bash
                    echo "Vérification de Docker..."
                    docker version
                    docker ps
                    '''
                }
            }
        }

        stage('Start MySQL') {
            steps {
                script {
                    sh '''
                    #!/bin/bash
                    echo "Démarrage de MySQL..."

                    # Vérifier si le conteneur existe déjà
                    if docker ps --format '{{.Names}}' | grep -q "^${MYSQL_CONTAINER}$"; then
                        echo "Le conteneur MySQL est déjà en cours d'exécution."
                    elif docker ps -a --format '{{.Names}}' | grep -q "^${MYSQL_CONTAINER}$"; then
                        echo "Le conteneur MySQL existe mais est arrêté. Redémarrage..."
                        docker start "${MYSQL_CONTAINER}"
                    else
                        echo "Démarrage d'un nouveau conteneur MySQL..."
                        docker run --name "${MYSQL_CONTAINER}" \
                            --health-cmd="mysqladmin ping --silent" \
                            --health-interval=10s --health-timeout=5s --health-retries=5 \
                            -e MYSQL_DATABASE="${DB_NAME}" \
                            -e MYSQL_ROOT_PASSWORD="${DB_PASS}" \
                            -p "${DB_PORT}":3306 \
                            -d mysql:8
                    fi

                    echo "Attente de MySQL pour être prêt..."
                    for i in $(seq 1 30); do
                        if docker exec "${MYSQL_CONTAINER}" mysqladmin --user=root --password="${DB_PASS}" ping --silent; then
                            echo "MySQL est prêt."
                            break
                        fi
                        echo "Attente de MySQL (2 sec)..."
                        sleep 2
                    done

                    if ! docker exec "${MYSQL_CONTAINER}" mysqladmin --user=root --password="${DB_PASS}" ping --silent; then
                        echo "Échec du démarrage de MySQL après 60 secondes."
                        exit 1
                    fi
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    sh 'mvn test'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                /*
                withSonarQubeEnv('SonarQube') {
                    sh 'mvn sonar:sonar'
                }
                */
            }
        }

        stage('Deploy to Nexus') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'nexus-creds', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                    script {
                        sh '''
                        #!/bin/bash
                        echo "Déploiement vers Nexus..."
                        mvn deploy -DskipTests=true -DaltDeploymentRepository=deploymentRepo::default::${NEXUS_URL} -Dusername=${NEXUS_USER} -Dpassword=${NEXUS_PASS} -s ${MAVEN_SETTINGS}
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                echo "Pipeline terminé. Nettoyage des ressources..."
                sh '''
                #!/bin/bash
                docker stop "${MYSQL_CONTAINER}" || true
                docker rm "${MYSQL_CONTAINER}" || true
                '''
            }
        }
        failure {
            script {
                echo "Une erreur est survenue."
            }
        }
    }
}
