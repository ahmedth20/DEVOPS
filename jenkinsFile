pipeline {
    agent any

    environment {
        MYSQL_ROOT_PASSWORD = 'toor'
        MYSQL_DATABASE = 'kaddemdb'
        MYSQL_CONTAINER = 'mysql-test'
        MYSQL_IMAGE = 'mysql:5.7'
        APP_IMAGE_NAME = 'abdessalemch/alpine:1.0.0'
    }

    stages {
        stage('Checkout') {
            steps {
                echo "🔄 Récupération du code source..."
                checkout scm
            }
        }

        stage('Test Docker') {
            steps {
                echo "🔍 Vérification Docker..."
                sh 'whoami'
                sh 'docker version'
                sh 'docker ps'
            }
        }

        stage('Start MySQL') {
            steps {
                script {
                    echo "🧹 Nettoyage de l'ancien conteneur MySQL..."
                    sh """
                        docker rm -f ${MYSQL_CONTAINER} || true
                    """

                    echo "🚀 Lancement d’un nouveau conteneur MySQL..."
                    sh """
                        docker run -d --name ${MYSQL_CONTAINER} \
                            -e MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD} \
                            -e MYSQL_DATABASE=${MYSQL_DATABASE} \
                            -p 3306:3306 ${MYSQL_IMAGE}
                    """

                    echo "⌛ Attente de la disponibilité de MySQL..."
                    def ready = false
                    for (int i = 0; i < 15; i++) {
                        def status = sh (
                            script: "docker exec ${MYSQL_CONTAINER} mysqladmin ping -h 127.0.0.1 -uroot -p${MYSQL_ROOT_PASSWORD} --silent || true",
                            returnStatus: true
                        )
                        if (status == 0) {
                            echo "✅ MySQL est prêt."
                            ready = true
                            break
                        }
                        echo "⏳ Tentative ${i + 1}/15 : MySQL non prêt encore..."
                        sleep(time: 5, unit: 'SECONDS')
                    }

                    if (!ready) {
                        error "❌ MySQL ne s'est pas lancé correctement."
                    }
                }
            }
        }

        stage('Build') {
            steps {
                echo "🔧 Compilation de l'application..."
                sh './mvnw clean install'
            }
        }

        stage('Docker Build & Run') {
            steps {
                script {
                    echo "🐳 Construction de l'image Docker..."
                    sh "docker build -t ${APP_IMAGE_NAME} ."

                    echo "🚀 Lancement du conteneur de l'application..."
                    sh "docker run -d --name app-test -p 8085:8085 ${APP_IMAGE_NAME}"
                }
            }
        }
    }

    post {
        always {
            echo "🧹 Nettoyage des conteneurs..."
            sh 'docker rm -f mysql-test || true'
            sh 'docker rm -f app-test || true'
        }

        failure {
            echo "❌ Le pipeline a échoué."
        }

        success {
            echo "✅ Le pipeline a réussi."
        }
    }
}
